<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_task_form_inherit" model="ir.ui.view">
        <field name="name">project.task.form.inherit.joop</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_purchase_orders"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-credit-card"
                    invisible="purchase_order_count == 0"
                    groups="purchase.group_purchase_user">
                    <field name="purchase_order_count" widget="statinfo" string="Compras"/>
                </button>
            </xpath>

            <xpath expr="//page[@name='description_page']" position="after">
                <page string="Compras" name="purchase_page" groups="purchase.group_purchase_user">
                    <group>
                        <button name="action_create_purchase_order"
                            type="object"
                            string="Crear Orden de Compra"
                            class="btn-primary"
                            icon="fa-plus"/>
                    </group>
                    <field name="purchase_order_ids" nolabel="1">
                        <list string="Órdenes de Compra" create="0" delete="0">
                            <field name="name" string="Referencia"/>
                            <field name="partner_id" string="Proveedor"/>
                            <field name="date_order" string="Fecha"/>
                            <field name="amount_total" string="Total" sum="Total"/>
                            <field name="state" string="Estado" widget="badge"
                                decoration-success="state == 'purchase'"
                                decoration-info="state in ('draft', 'sent')"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_project_task_tree_inherit" model="ir.ui.view">
        <field name="name">project.task.tree.inherit.joop</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="purchase_order_count" optional="hide" string="OC" groups="purchase.group_purchase_user"/>
            </xpath>
        </field>
    </record>

</odoo>