<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_line_report_tree" model="ir.ui.view">
        <field name="name">purchase.order.line.report.tree.joop</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <list string="Líneas de Compra" create="false" edit="false" delete="false" sample="1">
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="date_order" widget="date"/>
                <field name="product_id"/>
                <field name="name" optional="hide"/>
                <field name="product_qty" string="Cantidad" sum="Cantidad"/>
                <field name="qty_received" string="Entregado" sum="Entregado"/>
                <field name="qty_invoiced" string="Facturado" sum="Facturado"/>
                <field name="product_uom_id" string="UoM"/>
                <field name="price_unit" optional="hide"/>
                <field name="price_subtotal" sum="Subtotal" optional="show"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_order_line_report_search" model="ir.ui.view">
        <field name="name">purchase.order.line.report.search.joop</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <search string="Líneas de Compra">
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <filter string="Confirmadas" name="confirmed" domain="[('state', 'in', ('purchase', 'done'))]"/>
                <filter string="Borrador/RFQ" name="draft" domain="[('state', 'in', ('draft', 'sent', 'to approve'))]"/>
                <separator/>
                <filter string="Fecha de orden" name="date_order" date="date_order"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Orden" name="group_order" context="{'group_by': 'order_id'}"/>
                    <filter string="Proveedor" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Producto" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Fecha de orden" name="group_date" context="{'group_by': 'date_order'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_purchase_order_line_report" model="ir.actions.act_window">
        <field name="name">Líneas de Compra</field>
        <field name="res_model">purchase.order.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_purchase_order_line_report_search"/>
        <field name="context">{'search_default_confirmed': 1, 'search_default_group_order': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay líneas de compra para mostrar
            </p>
        </field>
    </record>

    <record id="action_purchase_order_line_report_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_purchase_order_line_report_tree"/>
        <field name="act_window_id" ref="action_purchase_order_line_report"/>
    </record>

    <menuitem id="menu_purchase_order_line_report"
              name="Líneas de Compra"
              parent="purchase.purchase_report_main"
              action="action_purchase_order_line_report"
              sequence="50"
              groups="purchase.group_purchase_manager"/>

</odoo>