<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ticket_type_view_list" model="ir.ui.view">
        <field name="name">ticket.type.list</field>
        <field name="model">ticket.type</field>
        <field name="arch" type="xml">
            <list string="Tipos de Ticket" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>


    <record id="ticket_type_view_form" model="ir.ui.view">
        <field name="name">ticket.type.form</field>
        <field name="model">ticket.type</field>
        <field name="arch" type="xml">
            <form string="Tipo de Ticket">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ticket_type_action" model="ir.actions.act_window">
        <field name="name">Tipos de Ticket</field>
        <field name="res_model">ticket.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo tipo de ticket
            </p>
        </field>
    </record>

    <menuitem
        id="ticket_type_menu"
        name="Tipos de Ticket"
        parent="helpdesk.helpdesk_menu_config"
        action="ticket_type_action"
        sequence="10"
        groups="helpdesk.group_helpdesk_manager"/>

</odoo>