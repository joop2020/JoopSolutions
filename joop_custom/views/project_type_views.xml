<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_type_tree" model="ir.ui.view">
        <field name="name">project.type.tree</field>
        <field name="model">project.type</field>
        <field name="arch" type="xml">
            <list string="Tipos de Proyecto" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="project_template_id"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_project_type_form" model="ir.ui.view">
        <field name="name">project.type.form</field>
        <field name="model">project.type</field>
        <field name="arch" type="xml">
            <form string="Tipo de Proyecto">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre del tipo de proyecto..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_template_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Descripción del tipo de proyecto..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_project_type_search" model="ir.ui.view">
        <field name="name">project.type.search</field>
        <field name="model">project.type</field>
        <field name="arch" type="xml">
            <search string="Buscar Tipos de Proyecto">
                <field name="name"/>
                <field name="project_template_id"/>
                <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_project_type" model="ir.actions.act_window">
        <field name="name">Tipos de Proyecto</field>
        <field name="res_model">project.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un tipo de proyecto
            </p>
            <p>
                Los tipos de proyecto permiten clasificar proyectos y asociarlos con plantillas.
            </p>
        </field>
    </record>

    <menuitem id="menu_project_type"
        name="Tipos de Proyecto"
        parent="project.menu_project_config"
        action="action_project_type"
        sequence="10"/>

</odoo>